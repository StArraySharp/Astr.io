<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AstrIO.Server</RootNamespace>
    <AssemblyName>AstrIO.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Web 控制面板:构建时复制到输出目录(panel.html 从 ContentRoot 读取) -->
  <ItemGroup>
    <None Update="panel.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
